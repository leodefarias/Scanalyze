# ============================================================================
# Variáveis de Ambiente - Sistema de Micromedição Scanalyze
# ============================================================================
# Copie este arquivo para .env e preencha com suas credenciais
# NUNCA commite o arquivo .env no Git!

# === Oracle Database ===
ORACLE_HOST=oracle.fiap.com.br
ORACLE_PORT=1521
ORACLE_SID=orcl
ORACLE_USER=RM555211
ORACLE_PASSWORD=sua_senha_aqui

# === Backend API ===
PORT=8081
JAVA_OPTS=-Xmx512m -Xms256m

# === Azure Container Registry (para deploy) ===
# Obtenha esses valores no portal Azure
AZURE_REGISTRY_NAME=scanalyze
AZURE_REGISTRY_URL=scanalyze.azurecr.io
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# === Azure Container Apps ===
AZURE_RESOURCE_GROUP=rg-scanalyze
AZURE_LOCATION=eastus
AZURE_CONTAINER_APP_NAME=scanalyze-api
AZURE_CONTAINER_ENVIRONMENT=scanalyze-env

# === Frontend (Azure Static Web Apps) ===
# URL da API em produção (será atualizada após deploy do backend)
API_BASE_URL=https://scanalyze-api.azurecontainerapps.io
